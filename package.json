{
  "name": "image-cropper-plus",
  "version": "0.1.0",
  "description": "Framework-independent image cropping core extracted from hasujimaku",
  "type": "module",
  "sideEffects": false,
  "files": ["dist", "NOTICE"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "prepack": "pnpm build"
  },
  "packageManager": "pnpm@11.1.1"
}
