{
  "files": { "includes": ["**", "!dist", "!coverage"] },
  "formatter": { "indentStyle": "space", "lineWidth": 100 },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": { "noExplicitAny": "error" },
      "style": {
        "noExcessiveLinesPerFile": { "level": "error", "options": { "maxLines": 250 } }
      }
    }
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } }
}
